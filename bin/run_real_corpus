#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "digest"
require "fileutils"
require "json"
require "open3"
require "rbconfig"
require "time"
require "provider_generator"

root = File.expand_path("..", __dir__)
corpus = File.join(root, "test/fixtures/real_openapi")
output = File.expand_path(ARGV.fetch(0, File.join(root, "test/results")))
manifest = JSON.parse(File.read(File.join(corpus, "sources.json")))
sources = manifest.fetch("specifications")
FileUtils.mkdir_p(output)

results = sources.map do |source|
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  result = {
    "id" => source.fetch("id"),
    "provider" => source.fetch("provider"),
    "specification" => source.fetch("file"),
    "source_url" => source.fetch("url")
  }
  provider_output = File.join(output, source.fetch("id"))
  FileUtils.mkdir_p(provider_output)
  log = ["Анализ #{source.fetch('file')} для #{source.fetch('provider')}…"]

  begin
    path = File.join(corpus, source.fetch("file"))
    model = ProviderGenerator::Analyzer.new(
      ProviderGenerator::SpecLoader.load(path),
      provider: source.fetch("id"),
      overrides: ProviderGenerator::OverrideConfig.load(
        source["overrides"] && File.join(corpus, source["overrides"])
      )
    ).call
    expected = source.fetch("expected")
    actual_roles = {
      "create" => model.create_operation&.path,
      "status" => model.status_operation&.path,
      "webhook" => model.webhook_operation&.path
    }
    checks = {
      "sha256" => Digest::SHA256.file(path).hexdigest == source.fetch("sha256"),
      "operation_count" => model.operations.size == expected.fetch("operations"),
      "create_role" => actual_roles["create"] == expected["create"],
      "status_role" => actual_roles["status"] == expected["status"],
      "webhook_role" => actual_roles["webhook"] == expected["webhook"]
    }
    log << "Найдено операций: #{model.operations.length}"
    model.operations.each { |operation| log << "  #{operation.method.upcase} #{operation.path} (#{operation.id})" }
    log << "Авторизация: #{model.auth_summary}"
    log << "Подпись webhook: #{model.webhook_signature || 'не объявлена'}"
    model.warnings.each { |warning| log << "Предупреждение: #{warning}" }
    log << "Генерация сервиса, руководства и тестовых fixtures…"

    generated = ProviderGenerator::Generator.new(
      model,
      output: provider_output,
      documentation_output: provider_output
    ).call
    service = generated.find { |path| path.end_with?("_service.rb") }
    RubyVM::InstructionSequence.compile_file(service)
    checks["generated_ruby_syntax"] = true
    log << "Созданы файлы:"
    generated.each { |path| log << "  #{path.delete_prefix(root + '/')}" }
    checks.each { |name, passed| log << "#{passed ? 'ПРОЙДЕНО' : 'ОШИБКА'} #{name}" }

    result.merge!(
      "openapi_operations" => model.operations.size,
      "expected_roles" => expected.slice("create", "status", "webhook"),
      "detected_roles" => actual_roles,
      "auth" => model.auth_summary,
      "statuses" => model.statuses,
      "role_scores" => model.role_scores,
      "warnings" => model.warnings,
      "generated_files" => generated.map { |path| path.delete_prefix(root + "/") },
      "checks" => checks,
      "passed" => checks.values.all?
    )
  rescue StandardError, ScriptError => e
    log << "ОШИБКА #{e.class}: #{e.message}"
    log.concat(Array(e.backtrace))
    result.merge!(
      "passed" => false,
      "error" => { "class" => e.class.name, "message" => e.message }
    )
  ensure
    elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
    result["duration_ms"] = (elapsed * 1000).round
  end

  File.write(File.join(provider_output, "run.log"), log.join("\n") + "\n")
  File.write(File.join(provider_output, "result.json"), JSON.pretty_generate(result) + "\n")
  File.write(File.join(output, "#{source.fetch('id')}.json"), JSON.pretty_generate(result) + "\n")
  puts "#{result['passed'] ? 'ПРОЙДЕНО' : 'ОШИБКА'} #{source.fetch('id')} (#{result['duration_ms']} мс)"
  result
end

test_command = [RbConfig.ruby, "-I#{File.join(root, 'lib')}", File.join(root, "test/all_tests.rb"), "--verbose"]
test_stdout, test_stderr, test_status = Open3.capture3(*test_command, chdir: root)
full_test_output = [
  "$ #{test_command.join(' ')}",
  test_stdout,
  ("Стандартный поток ошибок:\n#{test_stderr}" unless test_stderr.empty?),
  "Код завершения: #{test_status.exitstatus}"
].compact.join("\n")
File.write(File.join(output, "full_test_output.log"), full_test_output + "\n")

summary = {
  "generated_at" => Time.now.utc.iso8601,
  "manifest_captured_at" => manifest.fetch("captured_at"),
  "providers" => results.size,
  "passed" => results.count { |result| result["passed"] },
  "failed" => results.count { |result| !result["passed"] },
  "openapi_operations" => results.sum { |result| result.fetch("openapi_operations", 0) },
  "full_test_suite" => {
    "command" => test_command.join(" "),
    "exit_code" => test_status.exitstatus,
    "passed" => test_status.success?,
    "output" => "full_test_output.log"
  },
  "results" => results.map { |result| { "id" => result["id"], "passed" => result["passed"], "duration_ms" => result["duration_ms"] } }
}
File.write(File.join(output, "summary.json"), JSON.pretty_generate(summary) + "\n")

exit(summary["failed"].zero? && test_status.success? ? 0 : 1)
