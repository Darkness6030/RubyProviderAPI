#!/usr/bin/env ruby
# frozen_string_literal: true

require "open-uri"
require "json"
require "digest"
require "optparse"
require "time"

accept = false
OptionParser.new do |parser|
  parser.banner = "Использование: update_real_corpus [--accept] [PROVIDER_ID ...]"
  parser.on("--accept", "Принять новые хеши после проверки изменений") { accept = true }
end.parse!

root = File.expand_path("..", __dir__)
corpus = File.join(root, "test/fixtures/real_openapi")
manifest_path = File.join(corpus, "sources.json")
manifest = JSON.parse(File.read(manifest_path))
sources = manifest.fetch("specifications")
selected = ARGV.empty? ? sources : sources.select { |source| ARGV.include?(source.fetch("id")) }
abort "Подходящие идентификаторы провайдеров не найдены." if selected.empty?

selected.each do |source|
  local = source.fetch("mode", "direct") == "local"
  warn "#{local ? 'Чтение' : 'Загрузка'} #{source.fetch('id')}…"
  raw = if local
          File.binread(File.expand_path(source.fetch("file"), corpus))
        else
          URI.open(source.fetch("url"), read_timeout: 60, open_timeout: 20, &:read)
        end
  content = if source.fetch("mode", "direct") == "redoc_state"
              state = raw[/const __redoc_state = (\{.*\});\s*var container/m, 1] or abort "Встроенное состояние Redoc не найдено."
              JSON.pretty_generate(JSON.parse(state).dig("spec", "data"))
            else
              raw
            end
  digest = Digest::SHA256.hexdigest(content)
  abort "Хеш изменился для #{source['id']}: #{digest}; проверьте изменения и повторите с --accept" if digest != source.fetch("sha256") && !accept
  source["sha256"] = digest
  File.binwrite(File.join(corpus, source.fetch("file")), content) unless local
end

if accept
  manifest["captured_at"] = Time.now.utc.strftime("%Y-%m-%d")
  File.write(manifest_path, JSON.pretty_generate(manifest) + "\n")
end
