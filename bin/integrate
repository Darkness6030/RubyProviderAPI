#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "provider_generator"

options = { lang: "ruby", output: "output", verbose: false, strict: false, verify: false }
parser = OptionParser.new do |opts|
  opts.banner = "Использование: integrate --spec ФАЙЛ --provider ИМЯ [--overrides ФАЙЛ] [--lang ruby] [--output КАТАЛОГ]"
  opts.on("--spec FILE", "OpenAPI 3 или Swagger 2.0 в YAML/JSON") { |value| options[:spec] = value }
  opts.on("--provider NAME", "Имя провайдера, например novapay") { |value| options[:provider] = value }
  opts.on("--lang LANGUAGE", "Язык результата (поддерживается только ruby)") { |value| options[:lang] = value }
  opts.on("--output DIR", "Каталог результата (по умолчанию: output)") { |value| options[:output] = value }
  opts.on("--docs-output DIR", "Каталог для INTEGRATION.md (по умолчанию: output)") { |value| options[:docs_output] = value }
  opts.on("--overrides FILE", "Необязательный универсальный YAML-файл уточнений") { |value| options[:overrides] = value }
  opts.on("-v", "--verbose", "Показать все найденные операции") { options[:verbose] = true }
  opts.on("--strict", "Вернуть ошибку, если остались предупреждения") { options[:strict] = true }
  opts.on("--verify", "Проверить синтаксис, контракт, сценарий и повторяемость результата") { options[:verify] = true }
  opts.on("-h", "--help", "Показать справку") { puts opts; exit }
end

begin
  parser.parse!
  raise OptionParser::MissingArgument, "--spec" unless options[:spec]
  raise OptionParser::MissingArgument, "--provider" unless options[:provider]
  raise OptionParser::InvalidArgument, "поддерживается только --lang ruby" unless options[:lang] == "ruby"

  puts "Чтение и анализ спецификации…"
  model = ProviderGenerator::Analyzer.new(
    ProviderGenerator::SpecLoader.load(options[:spec]),
    provider: options[:provider],
    overrides: ProviderGenerator::OverrideConfig.load(options[:overrides])
  ).call

  puts "Найдено операций: #{model.operations.length}"
  model.operations.each { |op| puts "  #{op.method.upcase} #{op.path}" } if options[:verbose]
  puts "Выбранная операция создания: #{model.create_operation ? "#{model.create_operation.method.upcase} #{model.create_operation.path}" : 'не определена'}"
  puts "Выбранная операция статуса: #{model.status_operation ? "#{model.status_operation.method.upcase} #{model.status_operation.path}" : 'не определена'}"
  puts "Входящий webhook: #{model.webhook_operation ? "#{model.webhook_operation.method.upcase} #{model.webhook_operation.path}" : 'не определён'}"
  puts "Авторизация: #{model.auth_summary}"
  puts "Подпись webhook: #{model.webhook_signature || 'не объявлена'}"
  model.warnings.each { |warning| warn "Предупреждение: #{warning}" }
  puts "Предупреждений: #{model.warnings.length}"
  puts "Генерация сервиса, руководства и тестовых fixtures…"

  files = ProviderGenerator::Generator.new(model, output: options[:output], documentation_output: options[:docs_output] || options[:output]).call
  puts "Созданы файлы:"
  files.each { |file| puts "  #{file}" }
  if options[:strict] && model.warnings.any?
    warn "Строгая проверка не пройдена: устраните предупреждения или подтвердите их через overrides."
    exit 3
  end
  if options[:verify]
    puts "Проверка сгенерированного пакета…"
    verification = ProviderGenerator::Verifier.new(
      model,
      files: files,
      output: options[:output],
      documentation_output: options[:docs_output] || options[:output]
    ).call
    verification[:checks].each do |check|
      marker = check[:passed] ? "✓" : "✗"
      puts "  #{marker} #{check[:name]}: #{check[:detail]}"
    end
    unless verification[:passed]
      warn "Проверка результата не пройдена."
      exit 4
    end
  end
rescue OptionParser::ParseError, ProviderGenerator::Error => e
  warn "Ошибка: #{e.message}"
  warn parser
  exit 2
end
